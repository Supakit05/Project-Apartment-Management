#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper startup batch script for Unix/Linux/macOS
# ----------------------------------------------------------------------------

# OS specific support.  $var _must_ be set to true or false.
cygwin=false
darwin=false
os400=false
hpux=false
case "`uname`" in
CYGWIN*) cygwin=true;;
Darwin*) darwin=true;;
OS400*) os400=true;;
HP-UX*) hpux=true;;
esac

# error handling function
failure() {
  echo "Error: $1" >&2
  exit 1
}

PRG="$0"

while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`realpath "$PRG"`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done

PRGDIR=`dirname "$PRG"`
BASE_DIR=`cd "$PRGDIR" && pwd`

# Locate maven wrapper jar
WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
  failure "Could not find $WRAPPER_JAR"
fi

# Determine Java command to use
if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

if [ ! -x "$JAVACMD" ] && [ ! -f "$JAVACMD" ]; then
  failure "JAVA_HOME is not set correctly or java command not found."
fi

# Execute Maven Wrapper
exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
